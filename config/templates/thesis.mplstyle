# Dissertation chart style: load with plt.style.use(os.environ["MPLSTYLE"])
font.family: serif
font.serif: Times New Roman, Times, DejaVu Serif
font.size: 11
axes.titlesize: 12
axes.labelsize: 11
axes.spines.top: False
axes.spines.right: False
axes.grid: True
grid.alpha: 0.3
grid.linestyle: --
axes.prop_cycle: cycler('color', ['1f3b57', 'c0504d', '4f81bd', '9bbb59', '8064a2', 'f79646', '4bacc6'])
legend.frameon: False
figure.figsize: 6.5, 4
figure.dpi: 100
savefig.dpi: 300
savefig.bbox: tight
savefig.facecolor: white
