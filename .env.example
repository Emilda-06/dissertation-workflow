# -----------------------------------------------------------------------------
# Private settings for the dissertation workflow.
#
# 1. Copy this file to a new file called .env in the same folder:
#       copy .env.example .env        (Windows Command Prompt)
#       cp .env.example .env          (Git Bash / macOS / Linux)
# 2. Fill in the values below. Write them as KEY=value, with no spaces around "=".
#
# .env is git-ignored, so your values are never committed or shared.
# Real environment variables with the same name take priority over this file.
# Run  .venv\Scripts\python.exe scripts\doctor.py  to check that it was picked up.
# -----------------------------------------------------------------------------

# Your own email address. Recommended.
# - Required by Unpaywall to find legal open-access full texts (research.py fulltext).
# - Puts OpenAlex and Crossref requests in their faster, more reliable "polite pool".
# It is sent only to Unpaywall, OpenAlex and Crossref. No account is needed.
# Example: CONTACT_EMAIL=jane.doe@university.ac.uk
CONTACT_EMAIL=

# Optional. OpenAlex API key - leave empty unless OpenAlex asks you for one.
OPENALEX_API_KEY=

# Optional. Port of the Zotero desktop app's local connector.
# Leave at 23119 (Zotero's default) unless you changed it in Zotero's settings.
ZOTERO_PORT=23119
