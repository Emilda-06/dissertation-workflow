{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe scripts/*)",
      "Bash(.venv/bin/python scripts/*)",
      "Bash(.venv/Scripts/python.exe -m pytest*)",
      "Bash(.venv/bin/python -m pytest*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(tools/pandoc.exe *)",
      "Bash(tools/pandoc *)",
      "WebSearch",
      "WebFetch(domain:api.openalex.org)",
      "WebFetch(domain:api.crossref.org)",
      "WebFetch(domain:api.semanticscholar.org)",
      "WebFetch(domain:doi.org)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:csrc.nist.gov)",
      "WebFetch(domain:www.rfc-editor.org)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { if [ -x .venv/Scripts/python.exe ]; then PY=.venv/Scripts/python.exe; else PY=.venv/bin/python; fi; \"$PY\" scripts/ensure_zotero.py; \"$PY\" scripts/project.py current 2>/dev/null | sed 's/^/Active dissertation project: /'; }",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
