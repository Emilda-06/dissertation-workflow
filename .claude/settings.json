{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe scripts/*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(tools/pandoc.exe *)",
      "WebSearch",
      "WebFetch(domain:api.openalex.org)",
      "WebFetch(domain:api.crossref.org)",
      "WebFetch(domain:api.semanticscholar.org)",
      "WebFetch(domain:doi.org)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:csrc.nist.gov)",
      "WebFetch(domain:www.rfc-editor.org)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/scripts/ensure_zotero.py\"",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
